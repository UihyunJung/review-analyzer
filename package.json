{
  "name": "review-analyzer",
  "displayName": "Place Review Analyzer",
  "version": "0.3.3",
  "description": "AI-powered restaurant & place review insights for Google Maps",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.cs-gmaps.config.js",
    "build:dev": "vite build --mode development && vite build --config vite.cs-gmaps.config.js --mode development",
    "lint": "eslint src/",
    "format:check": "prettier --check 'src/**/*.{ts,js}'",
    "format": "prettier --write 'src/**/*.{ts,js}'",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p workers/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "packageManager": "pnpm@9.15.9"
}
